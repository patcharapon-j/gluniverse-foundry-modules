<div class="stream-pacer-peril-text-content">
  <p class="notes">{{localize "STREAM_PACER.Settings.PerilTextHint"}}</p>
  {{#each fields}}
  <div class="form-group">
    <label for="sp-{{name}}">{{label}}</label>
    <input type="text" id="sp-{{name}}" name="{{name}}" value="{{value}}" placeholder="{{placeholder}}" maxlength="80">
  </div>
  {{/each}}
  <footer class="form-footer">
    <button type="submit"><i class="fas fa-save"></i> {{localize "STREAM_PACER.Save"}}</button>
  </footer>
</div>
