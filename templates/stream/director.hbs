<div class="gluniverse-stream-director-body" data-room-tab="{{tab.active}}">
{{!-- The on-air strip sits outside the read-only fieldset: start, stop, show UI and reframe are commands
     the stream client reads off the director's own User document, with no GM involved, so they must keep
     working for a co-host while no GM is connected. --}}
<header class="gluniverse-stream-onair" data-state="{{onAir.state}}">
  <div class="gluniverse-stream-onair-lamp" aria-hidden="true"></div>
  <div class="gluniverse-stream-onair-head">
    <span class="gluniverse-stream-onair-state">{{onAir.label}}</span>
    <span class="gluniverse-stream-onair-login">{{onAir.login}}</span>
  </div>
  <dl class="gluniverse-stream-onair-meta">
    <div><dt>{{localize "GLUNIVERSE_STREAM.room.meta.scene"}}</dt><dd>{{status.scene}}</dd></div>
    <div><dt>{{localize "GLUNIVERSE_STREAM.room.meta.camera"}}</dt><dd>{{status.mode}}</dd></div>
    <div><dt>{{localize "GLUNIVERSE_STREAM.room.meta.combat"}}</dt><dd>{{status.combat}}</dd></div>
  </dl>
  <div class="gluniverse-stream-onair-actions">
    {{#if onAir.live}}
    <button type="button" class="gluniverse-stream-btn" data-action="stop" title="{{localize 'GLUNIVERSE_STREAM.room.actions.stopHint'}}"><i class="fas fa-stop"></i> {{localize "GLUNIVERSE_STREAM.room.actions.stop"}}</button>
    {{else}}
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--primary" data-action="start" title="{{localize 'GLUNIVERSE_STREAM.room.actions.startHint'}}"><i class="fas fa-play"></i> {{localize "GLUNIVERSE_STREAM.room.actions.start"}}</button>
    {{/if}}
    <button type="button" class="gluniverse-stream-btn" data-action="toggle-restore" {{status.restoreDisabled}} aria-pressed="{{onAir.uiShowing}}" title="{{localize 'GLUNIVERSE_STREAM.room.actions.uiHint'}}"><i class="fas {{#if onAir.uiShowing}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{#if onAir.uiShowing}}{{localize "GLUNIVERSE_STREAM.room.actions.hideUi"}}{{else}}{{localize "GLUNIVERSE_STREAM.room.actions.showUi"}}{{/if}}</button>
    <button type="button" class="gluniverse-stream-btn" data-action="reframe" {{status.reframeDisabled}} title="{{localize 'GLUNIVERSE_STREAM.room.actions.reframeHint'}}"><i class="fas fa-crosshairs"></i> {{localize "GLUNIVERSE_STREAM.room.actions.reframe"}}</button>
  </div>
</header>

{{#if readOnly}}<p class="gluniverse-stream-form-hint gluniverse-stream-readonly"><strong>{{readOnlyMessage}}</strong></p>{{/if}}

<nav class="gluniverse-stream-tabs" role="tablist">
  {{#each tabs}}
  <button type="button" role="tab" class="gluniverse-stream-tab" data-action="room-tab" data-tab="{{id}}" aria-selected="{{#if active}}true{{else}}false{{/if}}"><i class="{{icon}}"></i> {{label}}</button>
  {{/each}}
</nav>

<fieldset class="gluniverse-stream-controls" {{#if readOnly}}disabled{{/if}}>

<div class="gluniverse-stream-tabpanel" role="tabpanel" data-tab="shot" {{#unless tab.shot}}hidden{{/unless}}>
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.camera.heading"}}</h2>
  <div class="gluniverse-stream-fields">
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.camera.outOfCombat"}}</span><select name="camera.outOfCombatMode">{{#each outOfCombatModeOptions}}<option value="{{value}}" {{selected}}>{{label}}</option>{{/each}}</select></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.camera.inCombat"}}</span><select name="camera.combatMode">{{#each combatModeOptions}}<option value="{{value}}" {{selected}}>{{label}}</option>{{/each}}</select></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.camera.sceneView"}}</span><select name="camera.sceneViewMode">{{#each sceneViewOptions}}<option value="{{value}}" {{selected}}>{{label}}</option>{{/each}}</select></label>
  </div>
  <h3>{{localize "GLUNIVERSE_STREAM.room.camera.padding"}}</h3>
  <div class="gluniverse-stream-sides">
    <span></span><span>{{localize "GLUNIVERSE_STREAM.room.side.top"}}</span><span>{{localize "GLUNIVERSE_STREAM.room.side.right"}}</span><span>{{localize "GLUNIVERSE_STREAM.room.side.bottom"}}</span><span>{{localize "GLUNIVERSE_STREAM.room.side.left"}}</span>
    <span>{{localize "GLUNIVERSE_STREAM.room.camera.percent"}}</span>
    <input type="number" name="camera.paddingPercentTop" value="{{camera.paddingPercentTop}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.percent'}} {{localize 'GLUNIVERSE_STREAM.room.side.top'}}">
    <input type="number" name="camera.paddingPercentRight" value="{{camera.paddingPercentRight}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.percent'}} {{localize 'GLUNIVERSE_STREAM.room.side.right'}}">
    <input type="number" name="camera.paddingPercentBottom" value="{{camera.paddingPercentBottom}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.percent'}} {{localize 'GLUNIVERSE_STREAM.room.side.bottom'}}">
    <input type="number" name="camera.paddingPercentLeft" value="{{camera.paddingPercentLeft}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.percent'}} {{localize 'GLUNIVERSE_STREAM.room.side.left'}}">
    <span>{{localize "GLUNIVERSE_STREAM.room.camera.grid"}}</span>
    <input type="number" name="camera.paddingGridSpacesTop" value="{{camera.paddingGridSpacesTop}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.grid'}} {{localize 'GLUNIVERSE_STREAM.room.side.top'}}">
    <input type="number" name="camera.paddingGridSpacesRight" value="{{camera.paddingGridSpacesRight}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.grid'}} {{localize 'GLUNIVERSE_STREAM.room.side.right'}}">
    <input type="number" name="camera.paddingGridSpacesBottom" value="{{camera.paddingGridSpacesBottom}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.grid'}} {{localize 'GLUNIVERSE_STREAM.room.side.bottom'}}">
    <input type="number" name="camera.paddingGridSpacesLeft" value="{{camera.paddingGridSpacesLeft}}" step="1" aria-label="{{localize 'GLUNIVERSE_STREAM.room.camera.grid'}} {{localize 'GLUNIVERSE_STREAM.room.side.left'}}">
  </div>
  <div class="gluniverse-stream-fields">
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.camera.minZoom"}}</span><input type="number" name="camera.minZoom" value="{{camera.minZoom}}" step="0.05"></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.camera.maxZoom"}}</span><input type="number" name="camera.maxZoom" value="{{camera.maxZoom}}" step="0.05"></label>
    <label class="gluniverse-stream-field" title="{{localize 'GLUNIVERSE_STREAM.room.camera.panSpeedHint'}}"><span>{{localize "GLUNIVERSE_STREAM.room.camera.panSpeed"}}</span><input type="number" name="camera.panSpeed" value="{{camera.panSpeed}}" step="1" min="1"></label>
  </div>
  <div class="gluniverse-stream-checks">
    <label><input type="checkbox" name="camera.excludeDefeated" {{#if camera.excludeDefeated}}checked{{/if}}> {{localize "GLUNIVERSE_STREAM.room.camera.excludeDefeated"}}</label>
    <label title="{{localize 'GLUNIVERSE_STREAM.room.camera.includeTargetsHint'}}"><input type="checkbox" name="camera.includeTargets" {{#if camera.includeTargets}}checked{{/if}}> {{localize "GLUNIVERSE_STREAM.room.camera.includeTargets"}}</label>
  </div>
</section>

<section class="gluniverse-stream-panel" {{#unless spotlightSelected}}data-quiet{{/unless}}>
  <h2>{{localize "GLUNIVERSE_STREAM.room.spotlight.heading"}}{{#unless spotlightSelected}} <small>{{localize "GLUNIVERSE_STREAM.room.spotlight.unused"}}</small>{{/unless}}</h2>
  <div class="gluniverse-stream-fields">
    <label class="gluniverse-stream-field" title="{{localize 'GLUNIVERSE_STREAM.room.spotlight.zoomHint'}}"><span>{{localize "GLUNIVERSE_STREAM.room.spotlight.zoom"}}</span><input type="number" name="camera.spotlightZoom" value="{{camera.spotlightZoom}}" step="0.1" min="0.05"></label>
    <label class="gluniverse-stream-field" title="{{localize 'GLUNIVERSE_STREAM.room.spotlight.travelHint'}}"><span>{{localize "GLUNIVERSE_STREAM.room.spotlight.travel"}}</span><input type="number" name="camera.travelZoomOut" value="{{camera.travelZoomOut}}" step="0.25" min="1"></label>
  </div>
  <div class="gluniverse-stream-checks">
    <label title="{{localize 'GLUNIVERSE_STREAM.room.spotlight.playersOnlyHint'}}"><input type="checkbox" name="camera.spotlightPlayersOnly" {{#if camera.spotlightPlayersOnly}}checked{{/if}}> {{localize "GLUNIVERSE_STREAM.room.spotlight.playersOnly"}}</label>
  </div>
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.room.spotlight.hint"}}</p>
</section>

<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.tracking.heading"}}</h2>
  {{#if tokenRows.length}}
  <table class="gluniverse-stream-table">
    <thead><tr><th>{{localize "GLUNIVERSE_STREAM.room.tracking.token"}}</th><th>{{localize "GLUNIVERSE_STREAM.room.tracking.state"}}</th><th></th></tr></thead>
    <tbody>
      {{#each tokenRows}}
      <tr {{#if tracked}}data-tracked{{/if}}>
        <td><span class="gluniverse-stream-cell-main">{{name}}</span>{{#if actor}}<small>{{actor}}</small>{{/if}}</td>
        <td class="gluniverse-stream-tags">{{#if hidden}}<span>{{localize "GLUNIVERSE_STREAM.room.tracking.hidden"}}</span>{{/if}}{{#if defeated}}<span>{{localize "GLUNIVERSE_STREAM.room.tracking.defeated"}}</span>{{/if}}{{#if inCombat}}<span>{{localize "GLUNIVERSE_STREAM.room.tracking.inCombat"}}</span>{{/if}}{{#unless visibleHere}}<span>{{localize "GLUNIVERSE_STREAM.room.tracking.notVisible"}}</span>{{/unless}}</td>
        <td class="gluniverse-stream-cell-end"><button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="toggle-token" data-token-id="{{id}}" aria-pressed="{{#if tracked}}true{{else}}false{{/if}}">{{#if tracked}}{{localize "GLUNIVERSE_STREAM.room.tracking.untrack"}}{{else}}{{localize "GLUNIVERSE_STREAM.room.tracking.track"}}{{/if}}</button></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="gluniverse-stream-empty">{{localize "GLUNIVERSE_STREAM.room.tracking.empty"}}</p>
  {{/if}}
</section>
{{{sections.shot}}}
</div>

<div class="gluniverse-stream-tabpanel" role="tabpanel" data-tab="overlay" {{#unless tab.overlay}}hidden{{/unless}}>
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.chat.heading"}}</h2>
  <div class="gluniverse-stream-filter-entry">
    <span><span class="gluniverse-stream-label">{{localize "GLUNIVERSE_STREAM.room.chat.filter"}}</span> {{chatFilterSummary}}</span>
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="open-chat-filter" title="{{localize 'GLUNIVERSE_STREAM.room.chat.filterHint'}}"><i class="fas fa-filter"></i> {{localize "GLUNIVERSE_STREAM.room.chat.filterButton"}}</button>
  </div>
  <div class="gluniverse-stream-corners" role="radiogroup" aria-label="{{localize 'GLUNIVERSE_STREAM.room.chat.position'}}">
    <span class="gluniverse-stream-label">{{localize "GLUNIVERSE_STREAM.room.chat.position"}}</span>
    <div class="gluniverse-stream-corner-pad">
      {{#each chatPositionOptions}}
      <label class="gluniverse-stream-corner" data-corner="{{value}}" title="{{label}}"><input type="radio" name="chat.position" value="{{value}}" {{#if selected}}checked{{/if}}><span class="gluniverse-stream-sr">{{label}}</span></label>
      {{/each}}
    </div>
  </div>
  <div class="gluniverse-stream-fields">
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.chat.offsetX"}}</span><input type="number" name="chat.offsetX" value="{{chat.offsetX}}" step="1"></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.chat.offsetY"}}</span><input type="number" name="chat.offsetY" value="{{chat.offsetY}}" step="1"></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.chat.lifetime"}}</span><input type="number" name="chat.lifetimeMs" value="{{chat.lifetimeMs}}" step="500" min="{{chatLimits.lifetimeMs.min}}" max="{{chatLimits.lifetimeMs.max}}"></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.chat.maxVisible"}}</span><input type="number" name="chat.maxVisible" value="{{chat.maxVisible}}" step="1" min="{{chatLimits.maxVisible.min}}" max="{{chatLimits.maxVisible.max}}"></label>
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.chat.critLifetime"}}</span><input type="number" name="chat.critLifetimeMultiplier" value="{{chat.critLifetimeMultiplier}}" step="0.25" min="{{chatLimits.critLifetimeMultiplier.min}}" max="{{chatLimits.critLifetimeMultiplier.max}}"></label>
  </div>
  <label class="gluniverse-stream-range" title="{{localize 'GLUNIVERSE_STREAM.room.chat.cardScaleHint'}}"><span>{{localize "GLUNIVERSE_STREAM.room.chat.cardScale"}}</span>
    <input type="range" name="chat.cardScale" value="{{chat.cardScale}}" min="{{cardScale.min}}" max="{{cardScale.max}}" step="{{cardScale.step}}">
    <output data-for="chat.cardScale">{{cardScale.percent}}%</output>
  </label>
</section>
{{{sections.overlay}}}
</div>

<div class="gluniverse-stream-tabpanel" role="tabpanel" data-tab="screen" {{#unless tab.screen}}hidden{{/unless}}>
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.dialog.heading"}}</h2>
  <div class="gluniverse-stream-fields">
    <label class="gluniverse-stream-field"><span>{{localize "GLUNIVERSE_STREAM.room.dialog.lifetime"}}</span><input type="number" name="dialog.lifetimeMs" value="{{dialog.lifetimeMs}}" step="500" min="0"></label>
  </div>
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.room.dialog.hint"}}</p>
</section>

<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.ui.heading"}}</h2>
  {{#if detectedUi.length}}
  <table class="gluniverse-stream-table">
    <thead><tr><th>{{localize "GLUNIVERSE_STREAM.room.ui.element"}}</th><th>{{localize "GLUNIVERSE_STREAM.room.ui.state"}}</th><th>{{localize "GLUNIVERSE_STREAM.room.ui.layer"}}</th><th></th></tr></thead>
    <tbody>
      {{#each detectedUi}}
      <tr>
        <td><span class="gluniverse-stream-cell-main">{{title}}</span><small><code>{{selector}}</code> · {{source}}</small></td>
        <td>{{state}}</td>
        <td><input type="number" class="gluniverse-stream-layer" name="uiZIndex" data-rule-id="{{ruleId}}" value="{{zIndex}}" step="1" placeholder="{{localize 'GLUNIVERSE_STREAM.room.ui.layerAuto'}}" title="{{localize 'GLUNIVERSE_STREAM.room.ui.layerHint'}}"></td>
        <td class="gluniverse-stream-cell-end">
          <span class="gluniverse-stream-segmented">
            <button type="button" data-action="ui-allow" data-rule-id="{{ruleId}}">{{localize "GLUNIVERSE_STREAM.room.ui.allow"}}</button><button type="button" data-action="ui-block" data-rule-id="{{ruleId}}">{{localize "GLUNIVERSE_STREAM.room.ui.block"}}</button><button type="button" data-action="ui-default" data-rule-id="{{ruleId}}">{{localize "GLUNIVERSE_STREAM.room.ui.default"}}</button>
          </span>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="gluniverse-stream-empty">{{localize "GLUNIVERSE_STREAM.room.ui.empty"}}</p>
  {{/if}}
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.room.ui.hint"}}</p>
  <h3>{{localize "GLUNIVERSE_STREAM.room.ui.rules"}}</h3>
  <div class="gluniverse-stream-selector-rule">
    <input type="text" name="selectorRule.selector" placeholder="{{localize 'GLUNIVERSE_STREAM.room.ui.selectorPlaceholder'}}">
    <select name="selectorRule.action"><option value="block">{{localize "GLUNIVERSE_STREAM.room.ui.block"}}</option><option value="allow">{{localize "GLUNIVERSE_STREAM.room.ui.allow"}}</option></select>
    <input type="number" class="gluniverse-stream-layer" name="selectorRule.zIndex" step="1" placeholder="{{localize 'GLUNIVERSE_STREAM.room.ui.layer'}}" title="{{localize 'GLUNIVERSE_STREAM.room.ui.layerHint'}}">
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="selector-add"><i class="fas fa-plus"></i> {{localize "GLUNIVERSE_STREAM.room.ui.add"}}</button>
  </div>
  {{#if selectorRules.length}}
  <ul class="gluniverse-stream-selector-rules">
    {{#each selectorRules}}
    <li><code>{{selector}}</code><span class="gluniverse-stream-tags"><span>{{action}}</span>{{#if zIndex}}<span>z {{zIndex}}</span>{{/if}}</span><button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="selector-remove" data-rule-id="{{id}}">{{localize "GLUNIVERSE_STREAM.room.ui.remove"}}</button></li>
    {{/each}}
  </ul>
  {{/if}}
</section>
{{{sections.screen}}}
</div>

<div class="gluniverse-stream-tabpanel" role="tabpanel" data-tab="access" {{#unless tab.access}}hidden{{/unless}}>
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.access.login"}}</h2>
  <label class="gluniverse-stream-field gluniverse-stream-field--wide"><span>{{localize "GLUNIVERSE_STREAM.room.access.loginLabel"}}</span>
    <select name="streamUserId" {{#unless canEditAdmin}}disabled{{/unless}}>
      <option value="">{{localize "GLUNIVERSE_STREAM.room.access.none"}}</option>
      {{#each users}}
      <option value="{{id}}" {{selected}}>{{name}}{{#if active}} · {{../labels.connected}}{{/if}}</option>
      {{/each}}
    </select>
  </label>
  <div class="gluniverse-stream-autostart">
    <span>{{#if status.autoStartEnabled}}{{localize "GLUNIVERSE_STREAM.room.access.autoStartOn"}}{{else}}{{localize "GLUNIVERSE_STREAM.room.access.autoStartOff"}}{{/if}}</span>
    {{#if status.autoStartCanEnable}}<button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="enable-auto-start"><i class="fas fa-bolt"></i> {{localize "GLUNIVERSE_STREAM.room.access.enable"}}</button>{{/if}}
    {{#if status.autoStartEnabled}}<button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="revoke-auto-start"><i class="fas fa-ban"></i> {{localize "GLUNIVERSE_STREAM.room.access.revoke"}}</button>{{/if}}
  </div>
</section>

{{#if canEditAdmin}}
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.room.access.directors"}}</h2>
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.room.access.directorsHint"}}</p>
  <div class="gluniverse-stream-user-list">
    {{#each users}}
    <label><input type="checkbox" name="trustedDirectorUserIds" value="{{id}}" {{checked}} {{#if isGM}}disabled{{/if}}> {{name}}{{#if isGM}} <small>{{../labels.gm}}</small>{{/if}}</label>
    {{/each}}
  </div>
</section>
{{else}}
<p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.room.access.adminOnly"}}</p>
{{/if}}
{{{sections.access}}}
</div>

</fieldset>

</div>
