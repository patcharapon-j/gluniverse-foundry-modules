<div class="gl-aoe-style-body">
  <p class="gl-aoe-style-intro">{{intro}}</p>
  <div class="gl-aoe-style-grid">
    {{#each rows}}
      <label class="gl-aoe-style-row" style="--gl-aoe-row-color: {{color}}">
        <span class="gl-aoe-style-name">{{label}}</span>
        <span class="gl-aoe-style-swatch"></span>
        <input type="color" name="colors.{{id}}" value="{{color}}" data-default="{{defaultColor}}">
        <code>{{color}}</code>
      </label>
    {{/each}}
  </div>
  <footer class="form-footer">
    <button type="button" class="gl-btn" data-action="reset"><i class="fa-solid fa-arrow-rotate-left"></i> {{reset}}</button>
    <button type="submit" class="gl-btn gl-btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{save}}</button>
  </footer>
</div>
