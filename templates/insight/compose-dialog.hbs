<form class="insight-compose-form" autocomplete="off">
  <fieldset class="insight-compose-to">
    <legend class="insight-compose-heading">
      <span>{{localize "INSIGHT.ComposeTarget"}}</span>
      {{#if hasPlayers}}
      <button type="button" class="insight-compose-all" data-action="pickNone">{{localize "INSIGHT.ComposePickNone"}}</button>
      {{/if}}
    </legend>
    {{#if hasPlayers}}
    <div class="insight-compose-picks">
      <button type="button" class="insight-compose-all" data-action="pickPlayers">{{localize "INSIGHT.ComposeAllPlayers"}}</button>
      <button type="button" class="insight-compose-all" data-action="pickSelected" data-tooltip="{{localize "INSIGHT.ComposePickSelectedHint"}}">{{localize "INSIGHT.ComposePickSelected"}}</button>
      <button type="button" class="insight-compose-all" data-action="pickTargets" data-tooltip="{{localize "INSIGHT.ComposePickTargetsHint"}}">{{localize "INSIGHT.ComposePickTargets"}}</button>
    </div>
    {{/if}}
    {{#if people.length}}
    <div class="insight-compose-people">
      {{#each people}}
      <label class="insight-person" style="--insight-person: {{this.color}}">
        <input type="checkbox" name="target" value="{{this.id}}" {{#if this.selected}}checked{{/if}}>
        <span class="insight-person-swatch" aria-hidden="true"></span>
        <span>{{this.name}}</span>
      </label>
      {{/each}}
    </div>
    {{else}}
    <p class="insight-compose-empty">{{localize "INSIGHT.ComposeNobody"}}</p>
    {{/if}}
  </fieldset>

  <label class="insight-compose-field">
    <span class="insight-compose-heading">{{localize "INSIGHT.ComposeLabel"}}</span>
    <input type="text" name="sense" maxlength="60" value="{{sense}}" placeholder="{{localize "INSIGHT.SenseDefault"}}">
  </label>

  <label class="insight-compose-field">
    <span class="insight-compose-heading">{{localize "INSIGHT.ComposeMessage"}}</span>
    <textarea name="message" placeholder="{{localize "INSIGHT.ComposeMessagePlaceholder"}}">{{message}}</textarea>
    <span class="insight-compose-hint">{{localize "INSIGHT.ComposeMessageHint"}}</span>
  </label>

  <footer class="insight-compose-foot">
    <label class="insight-compose-shared" data-tooltip="{{localize "INSIGHT.ComposeSharedHint"}}">
      <input type="checkbox" name="shared" {{#if shared}}checked{{/if}} {{#if soloPick}}disabled{{/if}}>
      <span class="insight-compose-shared-box" aria-hidden="true"></span>
      <span>{{localize "INSIGHT.ComposeShared"}}</span>
    </label>
    <button type="button" class="insight-send-btn" data-action="send">{{sendLabel}}</button>
  </footer>
</form>
