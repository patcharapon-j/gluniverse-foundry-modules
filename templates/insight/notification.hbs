{{!-- The arrival stage: a full-viewport, click-through layer. The edge is the
      alert; the card is the only thing that takes the pointer. Every node the
      renderer animates is hidden until its beat (styles/insight.css). --}}
<div class="insight-stage" data-id="{{id}}">

  {{!-- The edge: the room dims, the accent rises from all four sides, one
        hairline traces the viewport. Click-through. --}}
  <div class="insight-edge" aria-hidden="true">
    <div class="insight-edge-veil"></div>
    <div class="insight-edge-glow"></div>
    <div class="insight-edge-rim"></div>
  </div>

  <section class="insight-notification" role="alertdialog" aria-labelledby="{{id}}-sense" aria-describedby="{{id}}-body">
    {{!-- The cut: a rule of light the card opens down out of. --}}
    <div class="insight-cut" aria-hidden="true"></div>

    <div class="insight-card">
      <div class="insight-sweep" aria-hidden="true"></div>

      <header class="insight-head">
        <div class="insight-tag">
          <span class="insight-tag-mark" aria-hidden="true"></span>
          <span class="insight-sense" id="{{id}}-sense">{{#if sense}}{{sense}}{{else}}{{localize "INSIGHT.SenseDefault"}}{{/if}}</span>
        </div>
        <div class="insight-private">{{localize "INSIGHT.Private"}}</div>
      </header>

      {{#if title}}
      <h2 class="insight-title">{{title}}</h2>
      {{/if}}

      {{#if image}}
      <img class="insight-image" src="{{image}}" alt="">
      {{/if}}

      <div class="insight-body" id="{{id}}-body">{{{body}}}</div>

      <footer class="insight-foot">
        <span class="insight-queue" hidden></span>
        <button type="button" class="insight-dismiss">
          <span class="insight-dismiss-label">{{localize "INSIGHT.Dismiss"}}</span>
        </button>
      </footer>
    </div>
  </section>
</div>
