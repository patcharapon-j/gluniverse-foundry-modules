<div class="gltimer-panel-body">
  <div class="gltimer-panel-grid">
    <label class="gltimer-field">
      <span class="gltimer-field-label">{{localize "GLTIMER.panel.minutes"}}</span>
      <input class="gltimer-input" type="number" name="min" min="0" max="99" step="1" value="{{curM}}" />
    </label>
    <span class="gltimer-field-sep" aria-hidden="true">:</span>
    <label class="gltimer-field">
      <span class="gltimer-field-label">{{localize "GLTIMER.panel.seconds"}}</span>
      <input class="gltimer-input" type="number" name="sec" min="0" max="59" step="1" value="{{curS}}" />
    </label>
  </div>

  <div class="gltimer-presets">
    {{#each presets}}
      <button type="button" class="gltimer-preset" data-action="preset" data-m="{{this.m}}" data-s="{{this.s}}">{{this.label}}</button>
    {{/each}}
  </div>

  <div class="gltimer-panel-actions">
    <button type="button" class="gltimer-action is-primary" data-action="start">
      <i class="fa-solid fa-play" aria-hidden="true"></i>
      {{#if active}}{{localize "GLTIMER.panel.set"}}{{else}}{{localize "GLTIMER.panel.start"}}{{/if}}
    </button>
    {{#if active}}
      <button type="button" class="gltimer-action is-clear" data-action="clear">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "GLTIMER.panel.clear"}}
      </button>
    {{/if}}
  </div>
</div>
