<section class="gluniverse-stream-panel">
  <h2>Roll Cards</h2>
  <div class="gluniverse-stream-default-art">
    <label for="gluniverse-stream-default-roll-art">Default GM roll art</label>
    <input type="text" id="gluniverse-stream-default-roll-art" name="defaultRollArt.src" value="{{defaultRollArt.src}}" placeholder="path/to/picture.webp" title="Picture shown on a GM roll with no art of its own, such as a plain roll with no token." {{#unless canEdit}}disabled{{/unless}}>
    <button type="button" data-action="browse-default-roll-art" title="Pick a picture" {{#unless canEdit}}disabled{{/unless}}><i class="fas fa-file-import"></i> Browse</button>
    <button type="button" data-action="frame-default-roll-art" title="Choose how the default GM roll picture is framed" {{#unless defaultRollArt.src}}disabled{{/unless}}><i class="fas fa-crop-simple"></i> Frame</button>
  </div>
  <p class="gluniverse-stream-form-hint"><small>A GM roll with no art of its own — a plain roll with no token, or a creature still on a default icon — shows this picture instead of the monogram. Leave it empty to keep the monogram. {{#if defaultRollArt.focus}}Framed by hand.{{else}}Framed automatically.{{/if}}</small></p>
  <div class="gluniverse-stream-actions">
    <button type="button" data-action="portrait-framing" title="Choose how each character's picture is framed on PF2e roll cards"><i class="fas fa-crop-simple"></i> Frame Portraits</button>
  </div>
</section>


<section class="gluniverse-stream-panel">
  <h2>Status Updates</h2>
  <p class="gluniverse-stream-form-hint"><small>A small card, the size of the damage row, when a creature gains or loses a condition. An NPC also has to be standing somewhere a player could see it — a token on the scene that is not hidden — whatever is ticked here.</small></p>
  <div class="gluniverse-stream-user-list">
    <label title="Draw status cards at all."><input type="checkbox" name="statusUpdates.enabled" {{#if status.enabled}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.enabled"}}</label>
    <label title="PF2e condition items: frightened, prone, dying, persistent damage."><input type="checkbox" name="statusUpdates.conditions" {{#if status.conditions}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.conditions"}}</label>
    <label title="PF2e effect items: spell effects, stances, feat effects. There are a great many of these."><input type="checkbox" name="statusUpdates.effects" {{#if status.effects}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.effects"}}</label>
    <label title="A condition's value moving, such as frightened 1 rising to 2 or ticking back down."><input type="checkbox" name="statusUpdates.valueChanges" {{#if status.valueChanges}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.valueChanges"}}</label>
    <label title="A condition ending."><input type="checkbox" name="statusUpdates.removals" {{#if status.removals}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.removals"}}</label>
    <label title="Player characters and their familiars."><input type="checkbox" name="statusUpdates.players" {{#if status.players}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.players"}}</label>
    <label title="Creatures the GM runs, while a player can see them."><input type="checkbox" name="statusUpdates.npcs" {{#if status.npcs}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.npcs"}}</label>
  </div>
  <div class="gluniverse-stream-number-grid">
    <label class="gluniverse-stream-range">{{localize "GLUNIVERSE_STREAM.statusCard.settings.lifetimeFactor"}} <output data-for="statusUpdates.lifetimeFactor">{{statusLifetime.percent}}%</output>
      <input type="range" name="statusUpdates.lifetimeFactor" value="{{status.lifetimeFactor}}" min="{{statusLifetime.min}}" max="{{statusLifetime.max}}" step="{{statusLifetime.step}}" title="How long a status card stays up, as a share of the chat overlay's lifetime." {{#unless canEdit}}disabled{{/unless}}>
    </label>
  </div>
</section>


<section class="gluniverse-stream-panel">
  <h2>Rolls &amp; Chat</h2>
  <p class="gluniverse-stream-form-hint"><small>In a PF2e world every message goes through these cards, so a plain dice roll and a line somebody typed get one too. Only messages a person typed count as chat — in character, an emote, or out of character — never a system card that happens to carry text.</small></p>
  <div class="gluniverse-stream-user-list">
    <label title="Draw cards for plain rolls and chat at all."><input type="checkbox" name="basicCards.enabled" {{#if basic.enabled}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.enabled"}}</label>
    <label title="A plain dice roll: /r 2d6+3, a macro roll, anything PF2e did not claim as a check or damage."><input type="checkbox" name="basicCards.rolls" {{#if basic.rolls}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.rolls"}}</label>
    <label title="In-character speech."><input type="checkbox" name="basicCards.speech" {{#if basic.speech}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.speech"}}</label>
    <label title="Emotes, posted with /emote."><input type="checkbox" name="basicCards.emotes" {{#if basic.emotes}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.emotes"}}</label>
    <label title="Out-of-character chatter: table talk, and anything typed with no character speaking."><input type="checkbox" name="basicCards.ooc" {{#if basic.ooc}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.ooc"}}</label>
    <label title="Messages the GM typed, in or out of character."><input type="checkbox" name="basicCards.gm" {{#if basic.gm}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.basicCard.settings.gm"}}</label>
  </div>
</section>
