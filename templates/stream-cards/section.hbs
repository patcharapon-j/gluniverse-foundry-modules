<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.cardsPanel.heading"}}</h2>
  <div class="gluniverse-stream-default-art">
    <label class="gluniverse-stream-field gluniverse-stream-field--wide" title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.defaultArtTitle'}}"><span>{{localize "GLUNIVERSE_STREAM.cardsPanel.defaultArt"}}</span>
      <input type="text" name="defaultRollArt.src" value="{{defaultRollArt.src}}" placeholder="path/to/picture.webp" {{#unless canEdit}}disabled{{/unless}}>
    </label>
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="browse-default-roll-art" title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.browseHint'}}" {{#unless canEdit}}disabled{{/unless}}><i class="fas fa-file-import"></i> {{localize "GLUNIVERSE_STREAM.cardsPanel.browse"}}</button>
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="frame-default-roll-art" title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.frameHint'}}" {{#unless defaultRollArt.src}}disabled{{/unless}}><i class="fas fa-crop-simple"></i> {{localize "GLUNIVERSE_STREAM.cardsPanel.frame"}}</button>
  </div>
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.cardsPanel.defaultArtHint"}} {{#if defaultRollArt.focus}}{{localize "GLUNIVERSE_STREAM.cardsPanel.framedByHand"}}{{else}}{{localize "GLUNIVERSE_STREAM.cardsPanel.framedAuto"}}{{/if}}</p>
  <div class="gluniverse-stream-actions">
    <button type="button" class="gluniverse-stream-btn gluniverse-stream-btn--small" data-action="portrait-framing" title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.portraitsHint'}}"><i class="fas fa-crop-simple"></i> {{localize "GLUNIVERSE_STREAM.cardsPanel.portraits"}}</button>
  </div>
</section>

{{#if statusCards}}
<section class="gluniverse-stream-panel">
  <h2>{{localize "GLUNIVERSE_STREAM.cardsPanel.statusHeading"}}</h2>
  <p class="gluniverse-stream-form-hint">{{localize "GLUNIVERSE_STREAM.cardsPanel.statusHint"}} <a data-action="open-chat-filter">{{localize "GLUNIVERSE_STREAM.room.chat.filterButton"}}</a></p>
  <div class="gluniverse-stream-checks">
    <label title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.enabledHint'}}"><input type="checkbox" name="statusUpdates.enabled" {{#if status.enabled}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.enabled"}}</label>
    <label title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.valueChangesHint'}}"><input type="checkbox" name="statusUpdates.valueChanges" {{#if status.valueChanges}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.valueChanges"}}</label>
    <label title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.removalsHint'}}"><input type="checkbox" name="statusUpdates.removals" {{#if status.removals}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}> {{localize "GLUNIVERSE_STREAM.statusCard.settings.removals"}}</label>
  </div>
  <label class="gluniverse-stream-range" title="{{localize 'GLUNIVERSE_STREAM.cardsPanel.lifetimeHint'}}"><span>{{localize "GLUNIVERSE_STREAM.statusCard.settings.lifetimeFactor"}}</span>
    <input type="range" name="statusUpdates.lifetimeFactor" value="{{status.lifetimeFactor}}" min="{{statusLifetime.min}}" max="{{statusLifetime.max}}" step="{{statusLifetime.step}}" {{#unless canEdit}}disabled{{/unless}}>
    <output data-for="statusUpdates.lifetimeFactor">{{statusLifetime.percent}}%</output>
  </label>
</section>
{{/if}}
